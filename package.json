{
  "name": "noxi",
  "version": "1.0.0",
  "description": "A local-first web client for the OpenAI Responses API, ready for Vercel.",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "node scripts/build.mjs",
    "lint": "prettier --check public services routes middleware scripts tests api server.js playwright.config.js package.json vercel.json README.md",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": "24.x"
  },
  "keywords": [
    "openai",
    "express",
    "chat",
    "vanilla-js"
  ],
  "license": "MIT",
  "dependencies": {
    "docx": "^9.6.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "markdown-it": "^14.3.2",
    "multer": "^2.3.0",
    "openai": "^6.34.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.6"
  }
}
