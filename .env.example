OPENAI_API_KEY=
# Required: choose a strong shared access key locally and in Vercel. Never commit .env.
PASS_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MODEL_OPTIONS=gpt-6-sol,gpt-6-luna,gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna,gpt-5.4-mini,gpt-5.4,gpt-5.5,gpt-5.4-nano,gpt-4.1
DEFAULT_MAX_OUTPUT_TOKENS=4096
DEFAULT_CONTEXT_STRATEGY=all
DEFAULT_CONTEXT_WINDOW_SIZE=10
DEFAULT_TEMPERATURE=1
MAX_ATTACHMENTS_PER_MESSAGE=8
MAX_UPLOAD_MB=4
PORT=3000
OPENAI_DEVELOPER_MESSAGE=
